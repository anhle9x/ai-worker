# Built packages (may contain the company send code)
# Gói đã đóng (có thể chứa mã gửi của công ty)
dist/
# Signed update: made by packaging/release.sh, copy it to the server
# Bản cập nhật đã ký: do packaging/release.sh tạo, chép lên máy chủ
server/releases/
# The Go receiver built for the server by packaging/build-receiver.sh: copy it to the server with server/
# Bộ nhận Go dựng cho máy chủ bằng packaging/build-receiver.sh: chép lên máy chủ cùng server/
server/receiver-bin/
# Real send code + webhook address: only on the packaging computer
# Mã gửi + địa chỉ webhook thật: chỉ ở máy đóng gói
packaging/company.json
# Internal notes: server IP, company IP ranges
# Ghi chú nội bộ: IP máy chủ, dải IP công ty
TRANG-THAI.md
server/data/
server/keys/
# Engine-generated types
# Kiểu dữ liệu engine tự sinh
.claude-plugin/types/
node_modules/
.DS_Store
__pycache__/
*.pyc

# the menu bar app built on a Mac for one company: not part of the repository
# app thanh menu đóng gói trên Mac cho một công ty: không nằm trong repo
server/menubar/macos-app/dist/

# the manager extension zipped by packaging/build-extension.sh: built from extensions/manager
# tiện ích cho quản lý do packaging/build-extension.sh nén: dựng từ extensions/manager
server/menubar/AI-Worker-extension.zip

# the plugin installer for staff computers, fetched by packaging/windows-msi/fetch-msi.sh: a new one every version, kept out of git
# gói cài plugin cho máy nhân viên, lấy về bằng packaging/windows-msi/fetch-msi.sh: mỗi phiên bản một gói mới, không đưa vào git
server/menubar/AI-Worker-Plugin.msi
