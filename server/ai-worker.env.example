# Template for /etc/ai-worker.env. install.sh creates the real file and its key, so you only need this to look up a setting.
# Mẫu cho /etc/ai-worker.env. install.sh tự tạo file thật và mã gửi, nên bạn chỉ cần file này để tra cứu cài đặt.
# Never commit the real file: it holds INGEST_KEY. After changing it: sudo systemctl restart ai-worker-webhook
# Không bao giờ commit file thật vì nó chứa INGEST_KEY. Sửa xong thì chạy: sudo systemctl restart ai-worker-webhook

# Required. The key computers use to send numbers, at least 32 random characters: openssl rand -hex 24
# Bắt buộc. Mã các máy dùng để gửi số liệu, ít nhất 32 ký tự ngẫu nhiên: openssl rand -hex 24
INGEST_KEY=

# Port to listen on.
# Cổng nghe.
PORT=8788

# Address to listen on. Keep 127.0.0.1 and put Caddy or nginx in front, so traffic goes over HTTPS.
# Địa chỉ nghe. Nên giữ 127.0.0.1 và đặt Caddy hoặc nginx phía trước, để truy cập đi qua HTTPS.
BIND_ADDR=127.0.0.1

# 1 trusts X-Forwarded-For from a proxy on this machine; 0 does not. Empty: 1 when listening on 127.0.0.1, otherwise 0.
# 1 là tin X-Forwarded-For từ proxy trên máy này; 0 là không tin. Để trống: 1 khi nghe ở 127.0.0.1, còn lại là 0.
TRUST_PROXY=

# Language of the pages when the visitor has not chosen one: en or vi. Empty follows the browser.
# Ngôn ngữ của trang khi người xem chưa chọn: en hoặc vi. Để trống thì theo trình duyệt.
DEFAULT_LANG=

# Dong per US dollar, used only by the Vietnamese pages.
# Số đồng cho một đô la, chỉ dùng cho trang tiếng Việt.
USD_RATE=26000
# A folder with the company's own menu bar logo (icon-black.png, icon-white.png, 36x36 px); empty uses the logo in menubar/icons.
# Thư mục chứa logo thanh menu riêng của công ty (icon-black.png, icon-white.png, 36x36 px); để trống thì dùng logo trong menubar/icons.
MENUBAR_ICON_DIR=
# The macOS menu bar app built for this server (server/menubar/macos-app/build.sh makes the .zip); empty gives the SwiftBar installer.
# App thanh menu macOS đã đóng gói cho máy chủ này (server/menubar/macos-app/build.sh tạo file .zip); để trống thì phát gói cài SwiftBar.
MENUBAR_MAC_APP=

# Hours from UTC, used to split "today".
# Số giờ lệch UTC, dùng để chia "hôm nay".
TZ_OFFSET=7

# Open connections allowed at once.
# Số kết nối được mở cùng lúc.
MAX_CONNECTIONS=256

# Folders. Keep KEYS_DIR out of data backups, because it holds the OTP keys.
# Các thư mục. Để KEYS_DIR ngoài bản sao lưu dữ liệu, vì nó chứa khoá OTP.
DATA_DIR=/opt/ai-worker/data
KEYS_DIR=/opt/ai-worker/keys
RELEASES_DIR=/opt/ai-worker/releases

# File listing your branches and their network ranges. Template: branches.example.json
# File khai báo chi nhánh và dải mạng. Mẫu: branches.example.json
BRANCHES_FILE=/etc/ai-worker-branches.json

# Name shown in the authenticator app. No spaces.
# Tên hiện trong app xác thực. Không có dấu cách.
OTP_LABEL=AI-Worker

# Only to import accounts once, then manage them on /admin: name:SECRET,name2:SECRET2 (SECRET in base32). Leave empty.
# Chỉ để nhập tài khoản một lần, sau đó quản lý ở /admin: name:SECRET,name2:SECRET2 (SECRET dạng base32). Nên để trống.
OTP=
# Names in OTP imported as admin: name,name2
# Tên trong OTP được nhập với vai quản trị: name,name2
OTP_ADMINS=
# Names in OTP imported as wall display: name,name2
# Tên trong OTP được nhập với vai màn hình treo tường: name,name2
OTP_WALL=
