# AI Worker Office dashboard over HTTPS. A separate file, loaded with one line `import aiworker.caddy` at the end of the Caddyfile.
# Template: change aiworker.example.com and the list of IPs before use. To remove: delete that import line, then `sudo systemctl reload caddy`. It touches no other blocks / files.
# Bảng điều khiển Văn phòng AI Worker qua HTTPS. File riêng, nạp bằng một dòng `import aiworker.caddy` ở cuối Caddyfile.
# Mẫu: đổi aiworker.example.com và danh sách IP trước khi dùng. Gỡ: xoá dòng import đó rồi `sudo systemctl reload caddy`. Không đụng các khối khác / files.
aiworker.example.com {
	encode zstd gzip
	# separate access log for this site (rotated, keeps 10 files x 20 MB)
	# nhật ký truy cập riêng của trang này (xoay vòng, giữ 10 file x 20 MB)
	log {
		output file /var/log/caddy/aiworker.log {
			roll_size 20mb
			roll_keep 10
		}
	}
	# browsers may only come in over HTTPS; this domain only, it does not spread to other subdomains of example.com
	# trình duyệt chỉ vào bằng HTTPS; chỉ tên miền này, không lan sang tên miền con khác của example.com
	header Strict-Transport-Security "max-age=31536000"
	# only the allowed networks: replace these two sample ranges with your own IPs
	# chỉ các mạng được phép: thay hai dải mẫu này bằng IP của bạn
	@outside not remote_ip 203.0.113.0/24 198.51.100.0/24
	respond @outside "Forbidden" 403
	# For chosen computers away from these networks (home, 4G, travel): let them send numbers and fetch the plugin's updates (/update)
	# from anywhere. Set OFFICE_NETS in ai-worker.env to the same ranges first and restart the webhook, then let each computer on /admin
	# ("Any network"), then replace the two lines above with the block below. From outside, only a request carrying a computer's own key
	# (awd1.) to /ingest or /releases/ gets past Caddy; the server then takes it only from a computer an admin let, so the shared key in the
	# install package sends nothing from outside. The second matcher marks every request from outside, so the server holds the same rule
	# even if OFFICE_NETS is left empty. The viewing pages keep the IP list and OTP. Keep both lists the same (docs/INSTALL.md).
	# Máy được chọn ở ngoài các mạng này (ở nhà, 4G, đi công tác): cho gửi số liệu và tải bản cập nhật plugin (/update) từ mọi nơi.
	# Trước hết đặt OFFICE_NETS trong ai-worker.env đúng các dải này rồi khởi động lại webhook, rồi cho từng máy ở /admin ("Mọi mạng"),
	# rồi thay hai dòng trên bằng khối dưới. Từ ngoài, chỉ yêu cầu mang khoá riêng của một máy (awd1.) tới /ingest hay /releases/ mới qua
	# được Caddy; máy chủ chỉ nhận nó từ máy quản trị đã cho, nên khoá chung trong gói cài không gửi được gì từ ngoài. Bộ so thứ hai đánh
	# dấu mọi yêu cầu từ ngoài, để máy chủ giữ cùng luật đó kể cả khi OFFICE_NETS bị để trống. Trang xem vẫn giữ danh sách IP và OTP.
	# Giữ hai danh sách giống nhau (docs/INSTALL.vi.md).
	# @outside {
	# 	not remote_ip 203.0.113.0/24 198.51.100.0/24
	# 	not {
	# 		path /ingest /releases/*
	# 		header Authorization "Bearer awd1.*"
	# 	}
	# }
	# respond @outside "Forbidden" 403
	# @away not remote_ip 203.0.113.0/24 198.51.100.0/24
	# request_header @away X-AiWorker-Away 1
	# Only for an AI project or application that runs on a cloud server (AI_PROJECTS=1): let its IP reach /projects/ingest and nothing else.
	# Replace the two lines at the top with the block below and put the project's IP in place of 192.0.2.10. The path still needs the project's key.
	# Chỉ cho dự án hay ứng dụng AI chạy trên cloud (AI_PROJECTS=1): cho IP của nó tới /projects/ingest và không tới đâu khác.
	# Thay hai dòng ở trên cùng bằng khối dưới và đặt IP của dự án vào chỗ 192.0.2.10. Đường này vẫn cần khoá của dự án.
	# @outside {
	# 	not remote_ip 203.0.113.0/24 198.51.100.0/24
	# 	not {
	# 		remote_ip 192.0.2.10
	# 		path /projects/ingest
	# 	}
	# }
	# respond @outside "Forbidden" 403
	# Gemma on this same server for computers too weak to run it (server/gemma.caddy, docs/INSTALL.md "Gemma on a server"): remove the # below.
	# Gemma trên cùng máy chủ này cho máy quá yếu không tự chạy được (server/gemma.caddy, docs/INSTALL.vi.md "Gemma trên máy chủ"): bỏ dấu # dưới.
	# import gemma.caddy
	# The Telegram bot's path is for a program on this server alone, which calls the webhook directly: nothing that comes through here reaches it.
	# The webhook refuses such a request by itself; this line stops it one step earlier.
	# Đường của bot Telegram chỉ dành cho một chương trình trên chính máy chủ này, nó gọi thẳng webhook: không gì đi qua đây tới được đường đó.
	# Webhook tự từ chối yêu cầu như vậy; dòng này chặn sớm hơn một bước.
	@bot path /bot /bot/*
	respond @bot "Not found" 404
	reverse_proxy 127.0.0.1:8788
}
